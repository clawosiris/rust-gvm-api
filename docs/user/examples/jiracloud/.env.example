# GVM REST API
GVM_GATEWAY_BASE_URL=http://127.0.0.1:8080
GVM_GATEWAY_USERNAME=admin
GVM_GATEWAY_PASSWORD=admin

# Jira Cloud
JIRA_SITE_URL=https://example.atlassian.net
JIRA_EMAIL=greenbone@example.com
JIRA_API_TOKEN=change-me
JIRA_PROJECT_KEY=SEC

# Jira issue setup
JIRA_ISSUE_TYPE=Task
JIRA_FINDING_KEY_FIELD=GreenboneFindingKey
JIRA_LABELS=greenbone,gvm
JIRA_PRIORITY=

# Jira lifecycle
# Comma-separated Jira status names that should be treated as closed.
JIRA_CLOSED_STATUS_NAMES=
# Comma-separated Jira status categories that should be treated as closed.
JIRA_CLOSED_STATUS_CATEGORIES=Done
JIRA_REOPEN_TRANSITION_NAME=Reopen

# GVM report selection
JIRA_LOOKBACK_HOURS=24
JIRA_MIN_SEVERITY=4.0
