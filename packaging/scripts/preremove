#!/bin/sh
set -eu

case "${1:-remove}" in
  upgrade|deconfigure)
    exit 0
    ;;
esac

if command -v systemctl >/dev/null 2>&1; then
  if [ -d /run/systemd/system ]; then
    systemctl stop gvm-gateway.service || true
    systemctl disable gvm-gateway.service
  else
    systemctl disable gvm-gateway.service >/dev/null 2>&1 || true
  fi
fi
